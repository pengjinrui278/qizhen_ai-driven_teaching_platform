(mirror_app) {
	encode zstd gzip

	# A top-level navigation must never display a static-export RSC payload.
	@rsc_document expression path_regexp('rsc', '^(.+)\\.txt$') && header({'Sec-Fetch-Dest':'document'})
	handle @rsc_document {
		redir {re.rsc.1} 302
	}

	@health path /api/health
	handle @health {
		rewrite * /health
		reverse_proxy api:8000
	}

	handle /api/* {
		reverse_proxy api:8000 {
			transport http {
				read_timeout 180s
			}
		}
	}

	handle {
		root * /srv
		try_files {path} {path}.html {path}/ /index.html
		file_server
	}
}

learningmirror.cn, www.learningmirror.cn {
	import mirror_app
}

http://124.220.5.87 {
	import mirror_app
}
