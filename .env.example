# 复制为 .env 后按需修改。.env 已被 .gitignore 忽略，禁止提交真实密钥。
# 所有变量均以 MIRROR_ 前缀读取。

# 前端 API 地址（开发时指向本机后端；生产构建时留空，使用相对路径 /api）
NEXT_PUBLIC_API_BASE=http://localhost:8000

# CORS 来源（开发时填 http://localhost:3000；生产由 nginx 同域代理，可留空）
# MIRROR_CORS_ORIGINS=http://localhost:3000


# 数据库连接（默认值对应仓库根 compose.yml 的本地 PostgreSQL）
MIRROR_DATABASE_URL=postgresql+pg8000://mirror:mirror@localhost:5432/mirror

# CoursePack 根目录（默认为仓库内 coursepacks/）
# MIRROR_COURSEPACK_ROOT=

# 模型网关：stub = 确定性占位（无需密钥，默认）；
# openai_compatible = 国内通用大模型的 OpenAI 兼容接口（DeepSeek / 通义 / GLM）
MIRROR_LLM_PROVIDER=stub
# MIRROR_LLM_BASE_URL=https://api.deepseek.com
# MIRROR_LLM_API_KEY=
# MIRROR_LLM_MODEL=deepseek-v4-flash
# 请求超时（秒）；带推理链的模型建议不低于 120
# MIRROR_LLM_TIMEOUT=120
