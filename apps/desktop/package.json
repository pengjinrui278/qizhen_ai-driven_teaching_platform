{
  "name": "@mirror/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "学镜学习空间 Windows 桌面端",
  "author": "Learning Mirror Team",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cn.learningmirror.desktop",
    "productName": "学镜学习空间",
    "asar": true,
    "files": ["main.cjs", "offline.html"],
    "directories": {"output": "release", "buildResources": "build"},
    "win": {"target": ["nsis", "portable"], "icon": "build/icon.png"},
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "学镜学习空间",
      "artifactName": "LearningMirror-Windows-Setup-${version}-${arch}.${ext}"
    },
    "portable": {"artifactName": "LearningMirror-Windows-Portable-${version}-${arch}.${ext}"}
  }
}
